{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://testx-q62t.onrender.com/api/:path*"
    },
    {
      "source": "/lite/:match*",
      "destination": "/lite/:match*"
    },
    {
      "source": "/((?!api|lite).*)",
      "destination": "/index.html"
    }
  ]
}
