{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://testx-q62t.onrender.com/api/$1"
    },
    {
      "source": "/api",
      "destination": "https://testx-q62t.onrender.com/api"
    },
    {
      "source": "/lite/:match*",
      "destination": "/lite/:match*"
    },
    {
      "source": "/((?!api|lite).*)",
      "destination": "/index.html"
    }
  ]
}
